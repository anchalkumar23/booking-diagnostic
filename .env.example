DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/booking_diagnostic
# Optional: if unset, a random JWT secret is generated at process startup
# (fine for local dev; tokens just won't survive a restart). Set a real
# value here for anything beyond local testing.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Shared secret the payment webhook caller must send back. Change this for
# anything beyond local testing/demo use.
WEBHOOK_SECRET=local-dev-webhook-secret
